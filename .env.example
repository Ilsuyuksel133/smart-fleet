# Copy it first: cp .env.example .env
GF_SECURITY_ADMIN_PASSWORD=change-me
# MySQL: password of the "fleet" user the API connects with, and of root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
ALERT_TEMP_THRESHOLD=80
LOG_LEVEL=INFO

# AI incident agent: "ollama" (local model on the host) or "fake" (scripted, no model needed)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
