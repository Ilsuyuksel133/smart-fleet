{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Fleet API",
    "version": "1.0.0"
  },
  "paths": {
    "/vehicles": {
      "get": {
        "summary": "List Vehicles",
        "operationId": "list_vehicles_vehicles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VehicleOut"
                  },
                  "type": "array",
                  "title": "Response List Vehicles Vehicles Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add Vehicle",
        "operationId": "add_vehicle_vehicles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{vehicle_id}/data": {
      "post": {
        "summary": "Send Data",
        "operationId": "send_data_vehicles__vehicle_id__data_post",
        "parameters": [
          {
            "name": "vehicle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Vehicle Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataSavedOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/{vehicle_id}/status": {
      "get": {
        "summary": "Get Status",
        "operationId": "get_status_vehicles__vehicle_id__status_get",
        "parameters": [
          {
            "name": "vehicle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Vehicle Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleStatusOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "summary": "Get Alerts",
        "operationId": "get_alerts_alerts_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "vehicle_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vehicle Id"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "high_temperature",
                    "abnormal_status"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertOut"
                  },
                  "title": "Response Get Alerts Alerts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Get Stats",
        "operationId": "get_stats_stats_get",
        "parameters": [
          {
            "name": "minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": 1,
              "default": 15,
              "title": "Minutes"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus Metrics",
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "high_temperature",
              "abnormal_status"
            ],
            "title": "Type"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "type",
          "reason",
          "timestamp"
        ],
        "title": "AlertOut"
      },
      "DataSavedOut": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "alerts_checked": {
            "type": "boolean",
            "title": "Alerts Checked"
          }
        },
        "type": "object",
        "required": [
          "message",
          "alerts_checked"
        ],
        "title": "DataSavedOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SensorData": {
        "properties": {
          "temperature": {
            "type": "number",
            "title": "Temperature"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "temperature",
          "status"
        ],
        "title": "SensorData"
      },
      "SensorLogOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "temperature": {
            "type": "number",
            "title": "Temperature"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "id",
          "vehicle_id",
          "temperature",
          "status",
          "timestamp"
        ],
        "title": "SensorLogOut"
      },
      "StatsOut": {
        "properties": {
          "window_minutes": {
            "type": "integer",
            "title": "Window Minutes"
          },
          "vehicles_total": {
            "type": "integer",
            "title": "Vehicles Total"
          },
          "vehicles_not_ok": {
            "type": "integer",
            "title": "Vehicles Not Ok"
          },
          "alerts_by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "high_temperature",
                "abnormal_status"
              ]
            },
            "type": "object",
            "title": "Alerts By Type"
          },
          "per_vehicle": {
            "items": {
              "$ref": "#/components/schemas/VehicleStatsOut"
            },
            "type": "array",
            "title": "Per Vehicle"
          }
        },
        "type": "object",
        "required": [
          "window_minutes",
          "vehicles_total",
          "vehicles_not_ok",
          "alerts_by_type",
          "per_vehicle"
        ],
        "title": "StatsOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VehicleCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "VehicleCreate"
      },
      "VehicleOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "title": "VehicleOut"
      },
      "VehicleStatsOut": {
        "properties": {
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "readings": {
            "type": "integer",
            "title": "Readings"
          },
          "avg_temperature": {
            "type": "number",
            "title": "Avg Temperature"
          },
          "max_temperature": {
            "type": "number",
            "title": "Max Temperature"
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "name",
          "readings",
          "avg_temperature",
          "max_temperature"
        ],
        "title": "VehicleStatsOut"
      },
      "VehicleStatusOut": {
        "properties": {
          "vehicle_id": {
            "type": "integer",
            "title": "Vehicle Id"
          },
          "logs": {
            "items": {
              "$ref": "#/components/schemas/SensorLogOut"
            },
            "type": "array",
            "title": "Logs"
          }
        },
        "type": "object",
        "required": [
          "vehicle_id",
          "logs"
        ],
        "title": "VehicleStatusOut"
      }
    }
  }
}
