// Collects Docker container logs and ships them to Loki.

// 1) Discover only the containers of this Compose project
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=smart-fleet"]
  }
}

// 2) Labels: only the low-cardinality "service" (Compose service name)
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// 3) Read container logs from the Docker API
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.levels.receiver]
}

// 4) Extract the "level" field from the log line and turn it into a label.
//    Fields such as vehicle_id or path are NOT labels; queries parse them with "| json".
loki.process "levels" {
  // Our own services write JSON logs
  stage.match {
    selector = "{service=~\"api|simulator|agent\"}"

    stage.json {
      expressions = { level = "" }
    }
  }

  // Prometheus, Grafana, Loki and Alloy write logfmt (level=info ...)
  stage.match {
    selector = "{service!~\"api|simulator|agent\"}"

    stage.logfmt {
      mapping = { level = "" }
    }
  }

  // Normalize levels: INFO -> info, warn -> warning
  stage.template {
    source   = "level"
    template = "{{ if eq (ToLower .Value) \"warn\" }}warning{{ else }}{{ ToLower .Value }}{{ end }}"
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.default.receiver]
}

// 5) Ship to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
